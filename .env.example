# React 开发服务器跨域来源，多个地址用逗号分隔。
ACCOUNT_IMPORT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 单批兑换进度轮询间隔与最长等待时间（秒）。
ACCOUNT_IMPORT_POLL_INTERVAL=5
ACCOUNT_IMPORT_MAX_WAIT=600

# Sub2API 持久化配置文件；默认使用项目内 data/config.json。
ACCOUNT_IMPORT_CONFIG_FILE=/home/orca/projects/account-import/data/config.json

# 本地账号记录 SQLite；只保存账号 ID、邮箱、兑换码和操作结果，不保存凭据。
ACCOUNT_IMPORT_DATABASE_FILE=/home/orca/projects/account-import/data/account-import.db
